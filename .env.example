# ==============================
# 환경변수 템플릿 (.env.example)
# 팀원 각자 아래처럼 복사한 뒤, 비어있는 값(비밀번호)만 채워서 사용하세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어 git에 올라가지 않습니다. (각자 로컬 값만 다름)
# ==============================

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- MySQL (각자 로컬 docker mysql 접속 정보) ----------
# 로컬에 이미 mysql이 3306으로 떠있다면 3307 등 다른 포트로 바꾸세요.
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=coupon_db
MYSQL_USER=coupon_user
MYSQL_PASSWORD=
DB_HOST=localhost

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=

# ---------- Kafka ----------
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_UI_PORT=8090
